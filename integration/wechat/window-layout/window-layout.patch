+    def _ensure_chat_layout(self, root: Node) -> Node:
+        bounds = root.bounds
+        if bounds is None or bounds.width >= 800:
+            return root
+
+        self._assert_clean_surface(root)
+        resize = getattr(self._ensure_input(), "ensure_chat_window_size", None)
+        if resize is None or not resize(820, 525):
+            return root
+
+        # The geometry change can replace Qt's accessible controls. Read
+        # fresh nodes before looking for a session row or search field.
+        self._control_cache = None
+        deadline = time.monotonic() + 2.0
+        while time.monotonic() < deadline:
+            self._root = self.accessibility.main_window()
+            current = self._root
+            bounds = current.bounds
+            if bounds and bounds.width >= 800 and find_search_box(current, self.profile):
+                self._assert_clean_surface(current)
+                return current
+            self._sleep(0.1)
+        return self._ensure_root()
