+    def ensure_chat_window_size(self, width: int, height: int) -> bool:
+        """Resize only the validated WeChat top-level client in screen bounds."""
+        logical = self._accessible_window
+        if logical is None:
+            raise ControlNotFound("WeChat window geometry was not configured")
+        # Re-identify the real EWMH top-level client after a desktop relayout.
+        self._wechat_window = None
+        window = self.find_wechat_window()
+        physical = self._window_geometry(window)
+        scale_x = physical.width / logical.width
+        scale_y = physical.height / logical.height
+        if not (0.5 <= scale_y <= 4.0 and 0.5 <= scale_x <= 4.0 and abs(scale_x - scale_y) <= 0.10):
+            raise ControlNotFound("WeChat window has inconsistent X11 and AT-SPI bounds")
+        root = int(self.x11.XDefaultRootWindow(self.display))
+        screen = self._window_geometry(root)
+        wanted_width = max(physical.width, round(width * scale_x))
+        wanted_height = max(physical.height, round(height * scale_y))
+        if wanted_width > screen.width or wanted_height > screen.height:
+            return False
+        if (wanted_width, wanted_height) == (physical.width, physical.height):
+            return False
+        x = max(screen.x, min(physical.x, screen.right - wanted_width))
+        y = max(screen.y, min(physical.y, screen.bottom - wanted_height))
+        self.x11.XMoveResizeWindow(self.display, window, x, y, wanted_width, wanted_height)
+        self.x11.XFlush(self.display)
+        return True
