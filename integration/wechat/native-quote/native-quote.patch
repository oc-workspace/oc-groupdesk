+            raise ControlNotFound('quote menu did not remain in WeChat')
+
+    def click_active_wechat(self, x: int, y: int) -> None:
+        self._checked_pointer(x,y,active_only=True)
+        self._button(1)
+        if not self.is_active_wechat_window():
+            raise ControlNotFound('quote action left WeChat')
+
