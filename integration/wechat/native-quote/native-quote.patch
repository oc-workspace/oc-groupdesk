+    def _checked_pointer(self, x: int, y: int, *, active_only: bool = False) -> None:
+        if active_only:
+            if not self.is_active_wechat_window():
+                raise ControlNotFound('the active window is not WeChat')
+        else:
+            self.focus_wechat()
+        logical_x, logical_y = int(x), int(y)
+        event_x, event_y = self._to_x11_point(logical_x, logical_y)
+        expected_x, expected_y = self._expected_physical_point(logical_x, logical_y)
+        self.xtst.XTestFakeMotionEvent(self.display, -1, event_x, event_y, 0)
+        self.x11.XFlush(self.display)
+        time.sleep(self.event_delay)
+        pointer_x, pointer_y = self._pointer_position()
+        if abs(pointer_x-expected_x)>3 or abs(pointer_y-expected_y)>3:
+            raise ControlNotFound('pointer geometry changed; quote action cancelled')
+        if not self.is_active_wechat_window():
+            raise ControlNotFound('WeChat lost focus; quote action cancelled')
+
+    def _button(self, button: int) -> None:
+        self.xtst.XTestFakeButtonEvent(self.display, button, 1, 0)
+        self.xtst.XTestFakeButtonEvent(self.display, button, 0, 0)
+        self.x11.XFlush(self.display)
+        time.sleep(self.event_delay)
+
+    def right_click(self, x: int, y: int) -> None:
+        self._checked_pointer(x,y)
+        self._button(3)
