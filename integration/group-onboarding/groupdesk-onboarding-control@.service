[Unit]
Description=Restricted GroupDesk onboarding broker for %i
After=docker.service
Requires=docker.service
[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/docker/oc-projects/groupdesk-onboarding/current/host.py %i
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/docker/oc-projects/groupdesk-bots /opt/persist/groupdesk-bots /run/groupdesk-onboarding
IPAddressDeny=any
IPAddressAllow=localhost
[Install]
WantedBy=multi-user.target
