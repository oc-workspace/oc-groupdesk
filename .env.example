# Copy to /opt/persist/groupdesk/secrets/app.env outside Git, chmod 600.
# Generate independent random credentials; do not use these placeholder values.
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgres://groupdesk:replace-with-random-hex@groupdesk-postgres-1:5432/groupdesk
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
BOT_API_TOKEN=replace-with-at-least-32-random-characters
# For SSH tunnel access only; set true once HTTPS is configured.
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:3110
