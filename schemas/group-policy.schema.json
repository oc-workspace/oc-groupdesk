{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "topic_scope": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "proactive"
      ]
    },
    "participation": {
      "default": "moderate",
      "type": "string",
      "enum": [
        "quiet",
        "moderate",
        "active"
      ]
    },
    "persona": {
      "default": "gt-persona",
      "type": "string",
      "enum": [
        "gt-persona",
        "neutral"
      ]
    },
    "identity": {
      "default": {
        "disclosure": "when_asked",
        "personal_questions": "tactful"
      },
      "type": "object",
      "properties": {
        "disclosure": {
          "default": "when_asked",
          "type": "string",
          "enum": [
            "when_asked",
            "proactive",
            "roleplay"
          ]
        },
        "personal_questions": {
          "default": "tactful",
          "type": "string",
          "enum": [
            "tactful",
            "plain"
          ]
        }
      },
      "required": [
        "disclosure",
        "personal_questions"
      ],
      "additionalProperties": false
    },
    "timeouts": {
      "default": {
        "planner_seconds": 300,
        "request_seconds": 310,
        "direct_ttl_seconds": 420
      },
      "type": "object",
      "properties": {
        "planner_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "request_seconds": {
          "type": "integer",
          "minimum": 40,
          "maximum": 660
        },
        "direct_ttl_seconds": {
          "type": "integer",
          "minimum": 105,
          "maximum": 1800
        }
      },
      "required": [
        "planner_seconds",
        "request_seconds",
        "direct_ttl_seconds"
      ],
      "additionalProperties": false
    },
    "base_questions": {
      "default": false,
      "type": "boolean"
    },
    "base_social": {
      "default": false,
      "type": "boolean"
    },
    "topic_overrides": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "reply_depth": {
            "type": "string",
            "enum": [
              "default",
              "brief",
              "detailed"
            ]
          }
        },
        "required": [
          "reply_depth"
        ],
        "additionalProperties": false
      }
    },
    "language": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "follow",
            "restricted",
            "fixed"
          ]
        },
        "allowed": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "fallback": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "fixed": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "allow_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "allowed",
        "fallback",
        "allow_requested"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "topic_scope",
    "participation",
    "persona",
    "identity",
    "timeouts",
    "base_questions",
    "base_social",
    "topic_overrides",
    "language"
  ],
  "additionalProperties": false
}
