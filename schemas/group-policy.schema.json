{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "topic_scope": {
      "default": "all",
      "type": "string",
      "enum": [
        "all",
        "proactive"
      ]
    },
    "participation": {
      "default": "moderate",
      "type": "string",
      "enum": [
        "quiet",
        "moderate",
        "active"
      ]
    },
    "persona": {
      "default": "gt-persona",
      "type": "string",
      "enum": [
        "gt-persona",
        "neutral"
      ]
    },
    "base_questions": {
      "default": false,
      "type": "boolean"
    },
    "base_social": {
      "default": false,
      "type": "boolean"
    },
    "language": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "follow",
            "restricted",
            "fixed"
          ]
        },
        "allowed": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          }
        },
        "fallback": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "fixed": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "allow_requested": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "allowed",
        "fallback",
        "allow_requested"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "topic_scope",
    "participation",
    "persona",
    "base_questions",
    "base_social",
    "language"
  ],
  "additionalProperties": false
}
