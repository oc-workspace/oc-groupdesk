{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "windows": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "max_replies": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "minutes",
          "max_replies"
        ],
        "additionalProperties": false
      }
    },
    "catch_up": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "within_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "required": [
        "enabled",
        "within_minutes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "windows",
    "catch_up"
  ],
  "additionalProperties": false
}
